# AcneGuard Backend Production Configuration Template
ENVIRONMENT=production
PROJECT_NAME="AcneGuard AI"

# Generate a strong 256-bit random key in production: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL:
# For Local/Dev: sqlite:///./acneguard.db
# For Production (PostgreSQL): postgresql://user:password@db-host:5432/acneguard
DATABASE_URL=postgresql://acneguard:secret_db_password@postgres:5432/acneguard

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Allowed CORS origins (comma-separated list for production)
CORS_ORIGINS=https://acneguard.yourdomain.com,https://api.acneguard.yourdomain.com

# File limits
MAX_UPLOAD_SIZE_MB=10
